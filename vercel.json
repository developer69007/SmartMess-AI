{
  "version": 2,
  "builds": [
    {
      "src": "SmartmessAi-4/mess management/Frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "SmartmessAi-4/mess management/Backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "SmartmessAi-4/mess management/Backend/server.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "SmartmessAi-4/mess management/Frontend/dist/$1"
    }
  ]
}
